# ==============================================================================
# Prowler IASM Enterprise Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to suit your production environment.
# All environment variables are optional with secure production defaults.

# ------------------------------------------------------------------------------
# 1. API Server & Networking
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3755
API_BASE_URL=http://localhost:3755

# Security API Key for REST endpoints and Streamlit UI.
# If left empty, API operates in development/open mode.
# When set, all /api/v1/* requests require the X-API-Key header or ?api_key= query parameter.
API_KEY=

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Concurrency & Resource Safety
# ------------------------------------------------------------------------------
# Maximum number of concurrent scans executed simultaneously by this worker node.
# Additional scans are queued and executed as slots become available.
MAX_CONCURRENT_SCANS=2

# Maximum execution duration in seconds before an unresponsive scan is automatically killed.
SCAN_TIMEOUT_SECONDS=3600

# Automatic retention policy: Scans older than this number of days are pruned on startup.
# Set to 0 to disable automatic pruning.
SCAN_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 3. Storage & Artifacts
# ------------------------------------------------------------------------------
# Output directory where scan JSON, CSV, HTML, and ZIP artifacts are stored.
SCAN_OUTPUT_DIR=./scan_results

# Custom path to runner script (defaults to ./run_scan.sh)
# RUN_SCAN_SCRIPT=/app/run_scan.sh

# ------------------------------------------------------------------------------
# 4. Streamlit Test Dashboard (Optional)
# ------------------------------------------------------------------------------
STREAMLIT_PORT=8501
