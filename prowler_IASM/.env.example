# Prowler IASM Configuration Template
# Copy this file to .env and adjust variables as needed.

# Server / API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Concurrency & Resource Safety
# Maximum number of concurrent scans allowed simultaneously
MAX_CONCURRENT_SCANS=3

# Output Directory
OUTPUT_DIR=./scan_results

# Default AWS Scanning Regions
DEFAULT_REGIONS=us-east-1,ap-south-1

# Optional Streamlit Settings
STREAMLIT_PORT=8501

